# Server
PORT=3000
ENABLE_SWAGGER=true
SWAGGER_PASSWORD=your_secure_swagger_password
# Comma-separated list of allowed CORS origins (REST API)
ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.com
# Socket.IO allowed origin (must match ALLOWED_ORIGINS in production)
SOCKET_ORIGIN=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/play4cash

# Redis
REDIS_URI=redis://localhost:6379

# JWT Auth
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ACCESS_TOKEN_TTL_SECS=3600
JWT_REFRESH_TOKEN_TTL_SECS=86400

# Test-only login bypass (POST /api/login/fake) for e2e suites that can't automate a
# real Google sign-in. Requires NODE_ENV != production too (see configuration.ts) —
# it is hard-blocked in production regardless of this flag. Also requires the
# Gateway's own ENABLE_FAKE_LOGIN=true to let the route through unauthenticated.
ENABLE_FAKE_LOGIN=false

# Email
EMAIL_SERVICE=gmail
EMAIL_FROM=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_VERIFICATION_EXPIRY_MINUTES=60

# Binance API
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Withdrawals / Transactions
PROCESSING_EXPIRY_MINUTES=30
WITHDRAWAL_VERIFICATION_EXPIRY_MINUTES=30
MIN_WITHDRAWAL=10
JOB_CRON_WITHDRAWAL_IN_PROCESSING="*/5 * * * *"
GOOGLE_CLIENT_ID=web_client

# Isolated administrator authentication
GOOGLE_ADMIN_CLIENT_ID=admin_web_client
ADMIN_JWT_SECRET_KEY=use_a_distinct_high_entropy_secret
ADMIN_JWT_ACCESS_TOKEN_TTL_SECS=1800
ADMIN_JWT_REFRESH_TOKEN_TTL_SECS=28800
ADMIN_JWT_ISSUER=play4cash-api
ADMIN_JWT_AUDIENCE=play4cash-admin
